# Database configuration
DB_PATH=jobs.db

# Search preferences
REMOTE_ONLY=true

# Keywords to search (comma-separated)
# Add your preferred technologies and roles
KEYWORDS=frontend,react,vue,angular,javascript,python,fullstack,data analyst,junior,trainee

# Experience level filter
# Options: junior, trainee, sin experiencia
MIN_EXPERIENCE_LEVEL=junior

# Scraping interval (in minutes)
SCRAPE_INTERVAL_MINUTES=60
